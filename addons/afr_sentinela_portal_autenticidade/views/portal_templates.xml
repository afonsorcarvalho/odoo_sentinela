<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="form" name="Verificar Autenticidade — Formulário">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_text_block pt48 pb48">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-6">
                                <h1>Verificar autenticidade</h1>
                                <p class="text-muted">
                                    Envie o arquivo de leitura (ou um .zip contendo vários
                                    arquivos) para verificarmos a assinatura criptográfica e
                                    emitirmos o veredito de autenticidade.
                                </p>

                                <div t-if="erro" class="alert alert-danger" role="alert">
                                    <t t-esc="erro"/>
                                </div>

                                <form action="/verificar-autenticidade" method="post"
                                      enctype="multipart/form-data" class="mt-4">
                                    <div class="mb-3">
                                        <label for="arquivo" class="form-label">
                                            Arquivo ou .zip
                                        </label>
                                        <input type="file" name="arquivo" id="arquivo"
                                               class="form-control" required="required"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        Verificar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="processando" name="Verificar Autenticidade — Processando">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_text_block pt48 pb48">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-6 text-center">
                                <h1>Processando…</h1>
                                <div id="job" t-att-data-job-id="job_id">
                                    <p class="js_posicao">
                                        Posição na fila:
                                        <span t-esc="posicao"/>
                                    </p>
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Processando...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
