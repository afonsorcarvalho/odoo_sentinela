<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="laudo">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #000000;">
                    <h2 style="margin-bottom: 4px;">Laudo de Verificação de Autenticidade</h2>
                    <p style="color: #666666; margin-top: 0;">
                        Gerado em: <span t-esc="o.gerado_em"/>
                    </p>

                    <table style="border-collapse: collapse; margin-bottom: 16px;">
                        <tbody>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Total</td>
                                <td style="padding: 2px 0;"><strong t-esc="o.total"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Válidos</td>
                                <td style="padding: 2px 0;" t-esc="o.validos"/>
                            </tr>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Inválidos</td>
                                <td style="padding: 2px 0;" t-esc="o.invalidos"/>
                            </tr>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Incompletos</td>
                                <td style="padding: 2px 0;" t-esc="o.incompletos"/>
                            </tr>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Indeterminados</td>
                                <td style="padding: 2px 0;" t-esc="o.indeterminados"/>
                            </tr>
                            <tr>
                                <td style="padding: 2px 8px 2px 0;">Veredito</td>
                                <td style="padding: 2px 0;">
                                    <span t-if="o.todos_ok" style="color: #1e7e34; font-weight: bold;">
                                        Todos os arquivos autênticos
                                    </span>
                                    <span t-else="" style="color: #b02a2a; font-weight: bold;">
                                        Um ou mais arquivos falharam a verificação
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table style="border-collapse: collapse; width: 100%;">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Arquivo</th>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Estado</th>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Motivo</th>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Coletor</th>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Data de referência</th>
                                <th style="border: 1px solid #999999; padding: 4px 6px; background-color: #eeeeee; text-align: left;">Linhas</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.linha_ids" t-as="linha">
                                <td style="border: 1px solid #999999; padding: 4px 6px;" t-esc="linha.nome"/>
                                <td style="border: 1px solid #999999; padding: 4px 6px;">
                                    <span t-if="linha.estado == 'valido'" style="color: #1e7e34; font-weight: bold;">
                                        <t t-esc="linha.estado"/>
                                    </span>
                                    <span t-elif="linha.estado == 'invalido'" style="color: #b02a2a; font-weight: bold;">
                                        <t t-esc="linha.estado"/>
                                    </span>
                                    <span t-else="" style="color: #8a6d00; font-weight: bold;">
                                        <t t-esc="linha.estado"/>
                                    </span>
                                </td>
                                <td style="border: 1px solid #999999; padding: 4px 6px;" t-esc="linha.motivo"/>
                                <td style="border: 1px solid #999999; padding: 4px 6px;" t-esc="linha.coletor_id"/>
                                <td style="border: 1px solid #999999; padding: 4px 6px;" t-esc="linha.data_referencia"/>
                                <td style="border: 1px solid #999999; padding: 4px 6px;" t-esc="linha.total_linhas"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
